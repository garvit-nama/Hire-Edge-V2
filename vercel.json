{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://hireedge-backend.onrender.com/api/:path*" },
    { "source": "/health", "destination": "https://hireedge-backend.onrender.com/health" },
    { "source": "/models", "destination": "https://hireedge-backend.onrender.com/models" },
    { "source": "/analyse", "destination": "https://hireedge-backend.onrender.com/analyse" },
    { "source": "/status/:path*", "destination": "https://hireedge-backend.onrender.com/status/:path*" },
    { "source": "/report/:path*", "destination": "https://hireedge-backend.onrender.com/report/:path*" }
  ]
}