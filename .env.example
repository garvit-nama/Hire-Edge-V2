# HireEdge Environment Variables

# ════════════════════════════════════════════════════════════════════════════════
#  DATABASE CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════════
# For local development, leave this empty or set to SQLite:
# DATABASE_URL=sqlite:///hireedge.db

# For Supabase PostgreSQL (production):
# Get from: https://supabase.com/dashboard → Project Settings → Database
# Format: postgresql://postgres:PASSWORD@HOST:5432/postgres
# Replace PASSWORD with your Supabase database password
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# ════════════════════════════════════════════════════════════════════════════════
#  GROQ API CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════════
# Get from: https://console.groq.com → API Keys
# Must be at least 20 characters
GROQ_API_KEY=gsk_YOUR_API_KEY_HERE

# ════════════════════════════════════════════════════════════════════════════════
#  FLASK CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════════
# Secret key for JWT token signing (use: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-min-32-chars-recommended

# Environment: 'development', 'production'
FLASK_ENV=development

# ════════════════════════════════════════════════════════════════════════════════
#  DEPLOYMENT NOTES
# ════════════════════════════════════════════════════════════════════════════════
# RENDER DEPLOYMENT:
# 1. Create Supabase project: https://supabase.com
# 2. Get DATABASE_URL from Supabase Dashboard
# 3. Create Render web service and add these env vars
# 4. Set Start Command: python backend/app.py
#
# SUPABASE SETUP:
# 1. Sign up at https://supabase.com
# 2. Create new project
# 3. Go to Settings → Database → Connection String
# 4. Copy the PostgreSQL URI
# 5. Replace PASSWORD with your database password
# 6. Paste into DATABASE_URL above
#
# GROQ API KEY:
# 1. Sign up at https://console.groq.com
# 2. Generate API key
# 3. Paste into GROQ_API_KEY above
# 4. Key must be ≥ 20 characters
#
# SECRET KEY:
# Generate using: openssl rand -hex 32
# Or use any strong random string with mix of chars
