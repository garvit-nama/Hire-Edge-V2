# HireEdge Environment Variables

# ════════════════════════════════════════════════════════════════════════════════
#  DATABASE CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════════
# For local development, leave this empty or set to SQLite:
# DATABASE_URL=sqlite:///hireedge.db

# For Supabase PostgreSQL (production) — USE POOLED CONNECTION (port 6543):
# Get from: https://supabase.com/dashboard → Project Settings → Database → Connection Pooling
# Format: postgresql://postgres:PASSWORD@aws-0-[project-id].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@aws-0-YOUR_PROJECT.pooler.supabase.com:6543/postgres?sslmode=require

# ════════════════════════════════════════════════════════════════════════════════
#  GROQ API CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════════
# Get from: https://console.groq.com → API Keys
# Must be at least 20 characters
GROQ_API_KEY=gsk_YOUR_API_KEY_HERE

# ════════════════════════════════════════════════════════════════════════════════
#  FLASK CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════════
# Secret key for JWT token signing (generate: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-min-32-chars-recommended

# Environment: 'development', 'production'
FLASK_ENV=production

# ════════════════════════════════════════════════════════════════════════════════
#  CORS CONFIGURATION (REQUIRED)
# ════════════════════════════════════════════════════════════════════════════════
# Comma-separated list of allowed frontend origins
# MUST include your Vercel domain for production
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5000

# ════════════════════════════════════════════════════════════════════════════════
#  DEPLOYMENT NOTES
# ════════════════════════════════════════════════════════════════════════════════
# RENDER DEPLOYMENT:
# 1. Create Supabase project: https://supabase.com
# 2. Enable Connection Pooling: Settings → Database → Connection Pooling → Enable
# 3. Get pooled DATABASE_URL (port 6543, sslmode=require)
# 4. Create Render web service and add these env vars
# 5. Set Start Command: gunicorn --worker-class eventlet -w 1 --bind 0.0.0.0:$PORT backend:app
#
# SUPABASE SETUP:
# 1. Sign up at https://supabase.com
# 2. Create new project
# 3. Go to Settings → Database → Connection Pooling
# 4. Enable pooling and copy the pooled URI
# 5. Replace PASSWORD with your database password
# 6. Paste into DATABASE_URL above
#
# GROQ API KEY:
# 1. Sign up at https://console.groq.com
# 2. Generate API key
# 3. Paste into GROQ_API_KEY above
# 4. Key must be ≥ 20 characters
#
# SECRET KEY:
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
# Or use any strong random string with mix of chars